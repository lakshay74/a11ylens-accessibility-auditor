{
  "manifest_version": 3,
  "name": "A11yLens - Accessibility Auditor",
  "version": "0.1.0",
  "description": "Scan a page for accessibility issues and understand selected findings with WCAG guidance.",
  "action": {
    "default_title": "Open A11yLens",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ]
}
