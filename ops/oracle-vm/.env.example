# Public DNS name pointing to the Oracle VM's public IPv4 address.
API_DOMAIN=

# Backend settings; keep the real .env on the VM only.
APP_ENV=production
PORT=8000
FRONTEND_ORIGIN=
CHROME_EXTENSION_ORIGIN=
MONGODB_URI=
MONGODB_DATABASE=a11ylens
MONGODB_COLLECTION=reports
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SCAN_RATE_LIMIT=5
